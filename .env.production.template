# ─── Production Environment Variables Template ───────────────────────────

# Node Environment
NODE_ENV=production
PORT=3000

# MongoDB Connection (MongoDB Atlas URI)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://admin:securepassword@cluster0.mongodb.net/foodrush?retryWrites=true&w=majority

# Redis Connection (Upstash or Redis Labs Redis URL)
# Format: rediss://default:<password>@<endpoint>:<port>
REDIS_URL=rediss://default:your-secure-password@upstash-instance.upstash.io:6379

# RabbitMQ Broker Connection (CloudAMQP AMQP URL)
# Format: amqps://<username>:<password>@<host>/<vhost>
RABBITMQ_URL=amqps://user:password@rabbitmq-instance.cloudamqp.com/vhost

# Authentication Keys
# Generate a secure string (e.g. openssl rand -base64 32)
JWT_SECRET=your-extremely-secure-jwt-secret-key-goes-here

# Cloudinary Storage Configuration (Optional, for image uploads in restaurant service)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Frontend App URL (for CORS validation)
FRONTEND_URL=https://foodrush.vercel.app
